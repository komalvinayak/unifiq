# ── GEMINI API KEYS (get from aistudio.google.com) ──────────────────
# Add multiple keys — app rotates automatically when one hits rate limit
GEMINI_KEY_1=your_first_gemini_key_here
GEMINI_KEY_2=your_second_gemini_key_here
GEMINI_KEY_3=your_third_gemini_key_here

# ── GROQ API KEY (get from console.groq.com — free) ─────────────────
# Used as backup when all Gemini keys are rate limited
GROQ_API_KEY=your_groq_key_here

# ── GOOGLE SHEETS ────────────────────────────────────────────────────
# Path to your service account JSON file (downloaded from Google Cloud)
GOOGLE_SHEETS_CREDENTIALS=sheets_creds.json
# The name of your Google Spreadsheet
SPREADSHEET_NAME=unifiq-db
